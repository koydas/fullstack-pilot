# FullStack Pilot - local development secrets
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# SQL Server SA password (required by mssql and dependencies-service).
# Must satisfy SQL Server password policy.
MSSQL_SA_PASSWORD=ChangeThisStrong!Passw0rd

# PostgreSQL credentials (required by postgres and services-service).
POSTGRES_USER=fullstack
POSTGRES_PASSWORD=fullstack
